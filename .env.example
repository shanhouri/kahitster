# Settings for running on your own computer. Copy to .env and fill in.
# Never put real credentials in this file -- .env is gitignored, .env.example
# is not. When hosted online, the same names are set in the hosting dashboard.

# From https://developer.spotify.com/dashboard -> your app -> Settings.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Where Spotify sends you back after sign-in. Leave empty: it becomes
# http://127.0.0.1:8000/auth/callback on your computer and
# https://<your-site>/auth/callback online. Each address you use must be listed
# under "Redirect URIs" in the Spotify app's settings.
SPOTIFY_REDIRECT_URI=

# Address players use to reach the game, shown in the join QR code. Leave empty
# to use the hosting platform's address, or this computer's Wi-Fi address.
PUBLIC_BASE_URL=

# Database. Leave empty for a local file (kahitster.db). Online, paste the
# Postgres connection string from your database provider.
# DATABASE_URL=

# Signs host login cookies. Leave empty on your computer (one is generated and
# kept in .secret_key). Online it must be set to a long random value.
# SECRET_KEY=

PORT=8000
